{
  "$id": "https://hamanakam1.github.io/el-hidratador/schema/packet.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Published by El Hidratador 1.0.0. See the repository for the full contract.",
  "properties": {
    "acceptance": {
      "minLength": 1,
      "type": "string"
    },
    "acceptance_criteria": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "checkpoint": {
      "type": [
        "object",
        "null"
      ]
    },
    "context": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "string"
          },
          "hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "hash",
          "source",
          "body"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "files": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "type": "string"
    },
    "objective": {
      "minLength": 1,
      "type": "string"
    },
    "priority": {
      "type": "integer"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "task_id": {
      "description": "Ticket identifier, for example M-1001.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "type": "string"
    },
    "tests": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "trust": {
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "objective",
    "acceptance",
    "scope",
    "status",
    "trust",
    "context"
  ],
  "title": "El Hidratador packet",
  "type": "object"
}
